# All settings are optional. The Go server reads the process environment;
# copying this file to .env does not load it automatically.
WEAVE_CONFIG=server.yaml
WEAVE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/weave?sslmode=disable

# Fixed demo claims are not authentication. Keep the shared listener local.
WEAVE_ADDRESS=127.0.0.1:8080
WEAVE_WEB_ORIGIN=http://localhost:5173
OTEL_SDK_DISABLED=true

# Must match your database publication. Each server needs its own stable slot.
WEAVE_PUBLICATION=reactive_queries
WEAVE_SLOT=reactive_queries_v1
